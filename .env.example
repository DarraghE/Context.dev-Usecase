# Copy to .env and fill in. Never commit .env.

# --- Required for live mode (leave empty and set DEMO_REPLAY=1 to run offline) ---
ANTHROPIC_API_KEY=
CONTEXT_DEV_API_KEY=

# Signs magic-link tokens, session cookies and media URLs. Use 32+ random bytes.
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# SQLite for the hackathon (libsql file URL). Postgres in production (same schema).
DATABASE_URL=file:./data/app.db

# Local storage root (raw zips, food crops, blurred derivatives). S3_* in production.
STORAGE_DIR=./storage
# S3_BUCKET=
# S3_REGION=eu-north-1

APP_BASE_URL=http://localhost:3000

# 1 = replay recorded Claude and Context.dev responses (offline, free). 0 = live APIs.
DEMO_REPLAY=1
# 1 = save live responses into fixtures/replay/ (needs live keys).
RECORD=0
# 1 = show demo shortcuts (caterer sign-in link on the home page, "use sample export" buttons).
DEMO_MODE=1

# Optional per-stage model overrides (default: claude-opus-5-5 for every stage).
# Log any change in docs/decisions.md and re-run `npm run test:accuracy`.
# MODEL_FOOD_DETECT=
# MODEL_TEXT_EXTRACT=
# MODEL_PLACE_RESOLVE=
# MODEL_DISH_MATCH=
# MODEL_MENU=

# Optional tuning
# DETECT_BATCH_THRESHOLD=200
# DETECT_IMAGES_PER_REQUEST=1
# DETECT_CONCURRENCY=6
# CONTEXT_DEV_BATCH_THRESHOLD=12
