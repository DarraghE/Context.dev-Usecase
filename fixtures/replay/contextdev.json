        "json": { "requested": true, "success": true, "data": { "restaurant_name": "Pizzerie Starita", "menu_sections": [
          { "section": "Not to be missed", "items": [
            { "name": "Montanara Starita", "description": "Don Antonio creates this celebration of Neapolitan cuisine in the 80s. Tomato, provola cheese and more cheese; crispy outside and soft inside, because we start by frying it and then we place it into the oven, so as to create that irresistible crust. What makes it unique is the sauce, who’s secret recipe we jealously guard… indeed, greedily!", "price": ":null", "dietary_tags": [] },
            { "name": "Marinara Starita", "description": "Sicilian datterini cherry tomato sauce, light dough, the lively flavor of garlic placed in the center of the disc and then the bold taste of pecorino, black pepper and oregano. It evokes our grandmother’s sauce, chopped tomatoes that gradually become a rich and velvety sauce. This is a real signature dish, the Starita dish that is spoken of all over the world and that is well recognized throughout Italy.", "price": ":null", "dietary_tags": [] },
            { "name": "Corna di Maradona", "description": "The pizza dough is rolled in the shape of a horseshoe and plunged into the fryer: the result is a delicate fry, soft on the inside and fragrant outside. The creamy filling is of fresh sheep’s milk ricotta cheese, cicoli (pork cracklings) and black pepper.", "price": ":null", "dietary_tags": [] },
            { "name": "Angioletti Fritti", "description": "They come from a recipe of Don Antonio’s mother, who loved to eat these small cylindrical pieces of fried pizza dough sprinkled with sugar. They are ideal both as an appetizer, accompanied by fresh tomato and arugula, and as a dessert, garnished with Nutella or pistachio cream.", "price": ":null", "dietary_tags": [] } ] },
          { "section": "STARTERS", "items": [
            { "name": "Fried Angioletti", "description": "Fried pizza sticks with arugula and datterino tomatoes.", "price": ":null", "dietary_tags": [] },
